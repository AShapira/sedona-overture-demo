# Copy to .env.windows-s3-airgap and keep the real file out of Git.
SEDONA_IMAGE=docker.io/apache/sedona:1.9.0@sha256:a1acf172621652c926214259045b2324f75341026dd726db0bef7e21b4205525

# Windows directory dedicated to disposable Spark spill, inventory cache, and
# bounded local fallback output. The lab treats 20 GiB as the total budget.
SEDONA_SCRATCH_HOST_DIR=C:/sedona-overture-scratch
SEDONA_SCRATCH_BUDGET_GB=20
SEDONA_SCRATCH_RESERVE_GB=2

# Complete immutable release using Hive theme/type leaves.
OVERTURE_RELEASE=2026-07-22.0
OVERTURE_RELEASE_URI=s3a://overture/release/2026-07-22.0

# S3-compatible endpoint. Real credentials belong only in the ignored file.
S3_ENDPOINT=https://s3.airgap.example
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE_ACCESS=true
S3_SSL_ENABLED=true

JUPYTER_PORT=8888
SPARK_UI_PORT=4040
LAB_CONTAINER_CPUS=8
LAB_CONTAINER_MEMORY=24g
SEDONA_SPARK_LOCAL_CORES=8
SEDONA_SPARK_DRIVER_MEMORY=16g
SEDONA_SPARK_PARTITIONS=16
SEDONA_SPARK_LOG_LEVEL=ERROR

# Required geographic scales. State codes match Overture's country field.
# Example state codes: ["IL","XW","XG"]
MEDIUM_STATE_CODES=
# Example shape: [{"name":"City A","state_code":"AA"}]
SMALL_CITIES=
MEDIUM_SAMPLE_LIMIT=50000
SMALL_SAMPLE_LIMIT=10000
MAP_FEATURE_LIMIT=2000

# The default inventory lists file counts and bytes only. Set true for the
# more expensive per-type remote row-count actions.
REFRESH_RELEASE_INVENTORY=false
INVENTORY_INCLUDE_ROW_COUNTS=false

# Writes remain disabled until explicitly enabled. Use a prefix separate from
# the immutable release root. A clean S3 create denial may fall back to scratch.
WRITE_DERIVED=false
DERIVED_OUTPUT_URI=s3a://overture/derived/sedona-lab
ALLOW_LOCAL_DERIVED_FALLBACK=true

# Optional private-CA settings, used only with the TLS Compose override.
# S3_TRUSTSTORE_HOST_PATH=C:/sedona-overture-config/s3-truststore.p12
# S3_TRUSTSTORE_PASSWORD=changeit
