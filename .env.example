# Host path containing theme=*/type=* directories for one complete release.
OVERTURE_RELEASE_DIR=/absolute/path/to/overture/release/2026-07-22.0

# URI visible inside the container. For local files this matches the read-only
# mount in compose.yml. It may instead be s3a://bucket/prefix/release-id.
OVERTURE_RELEASE_URI=/data/overture
OVERTURE_RELEASE=2026-07-22.0

# Image is pinned by version and digest for repeatable air-gap operation.
SEDONA_IMAGE=docker.io/apache/sedona:1.9.0@sha256:a1acf172621652c926214259045b2324f75341026dd726db0bef7e21b4205525
JUPYTER_PORT=8888
SPARK_UI_PORT=4040
LAB_CONTAINER_CPUS=8
LAB_CONTAINER_MEMORY=24g

# All resource settings are configurable. Start conservatively and increase
# only after observing the Spark UI and host memory pressure.
SEDONA_SPARK_LOCAL_CORES=8
SEDONA_SPARK_DRIVER_MEMORY=16g
SEDONA_SPARK_PARTITIONS=16
SEDONA_SPARK_LOCAL_DIR=/var/tmp/spark
SEDONA_SPARK_LOG_LEVEL=ERROR
SEDONA_SCRATCH_BUDGET_GB=20
SEDONA_SCRATCH_RESERVE_GB=2

# Required geographic scales. State codes match Overture's country field;
# each city must identify its state code explicitly. Example state codes:
# ["IL","XW","XG"]
MEDIUM_STATE_CODES=
# Example shape: [{"name":"City A","state_code":"AA"}]
SMALL_CITIES=

# Medium -> small -> map-safe collection limits.
MEDIUM_SAMPLE_LIMIT=50000
SMALL_SAMPLE_LIMIT=10000
MAP_FEATURE_LIMIT=2000

# Optional S3-compatible settings. Keep real values only in ignored .env.
# S3_ENDPOINT=http://object-store:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
S3_PATH_STYLE_ACCESS=true
S3_SSL_ENABLED=false

# Remote inventory row counts are optional because they open every dataset.
REFRESH_RELEASE_INVENTORY=false
INVENTORY_INCLUDE_ROW_COUNTS=false

# Optional bounded output. Keep DERIVED_OUTPUT_URI separate from the release.
WRITE_DERIVED=false
# DERIVED_OUTPUT_URI=s3a://bucket/derived/sedona-lab
ALLOW_LOCAL_DERIVED_FALLBACK=true
